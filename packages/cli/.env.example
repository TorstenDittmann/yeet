# Yeet CLI Configuration
# Copy this file to .env in the directory you run `yeet` from

# Server URL for publishing sites
# Default when unset: https://yeet.page
YEET_SERVER_URL=http://localhost:3000

# Alternative variable name (YEET_SERVER_URL takes precedence)
# SERVER_URL=http://localhost:3000

# Examples:
# YEET_SERVER_URL=https://yeet.page
# YEET_SERVER_URL=https://yeet.yourdomain.com
# YEET_SERVER_URL=http://192.168.1.100:3000
