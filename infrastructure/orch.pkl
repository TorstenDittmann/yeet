amends "https://orch.torsten.work/pkl/v1alpha1/Application.pkl"

name = "yeet"

services {
  ["web"] {
    // CI replaces this tag with the digest it just built and pushed to GHCR.
    image = "ghcr.io/torstendittmann/yeet:latest"
    replicas = 1
    resources {
      cpu = "500m"
      memory = "512Mi"
    }
    secretEnv {
      ["ORIGIN"] = "origin"
      ["S3_REGION"] = "s3-region"
      ["S3_ENDPOINT"] = "s3-endpoint"
      ["S3_BUCKET"] = "s3-bucket"
      ["S3_ACCESS_KEY_ID"] = "s3-access-key-id"
      ["S3_ACCESS_KEY_SECRET"] = "s3-access-key-secret"
    }
    http = new Http {
      port = 3000
      public = true
      https = false
      healthPath = "/"
    }
  }
}

deploy {
  autoUpdate = false
  healthDeadline = "3m"
}
